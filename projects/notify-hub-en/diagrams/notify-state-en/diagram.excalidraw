      "boundElements": null,
      "id": "nt",
      "type": "text",
      "x": 40,
      "y": 690,
      "width": 1121.0,
      "height": 40.0,
      "text": "Note: retries use exponential backoff up to 5 times; after that the notification goes to the DLQ and is given up.\n“Given up” is an end state too — nothing vanishes quietly, every case stays on the record.",
      "originalText": "Note: retries use exponential backoff up to 5 times; after that the notification goes to the DLQ and is given up.\n“Given up” is an end state too — nothing vanishes quietly, every case stays on the record.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
