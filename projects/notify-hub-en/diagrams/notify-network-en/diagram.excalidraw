      "version": 1,
      "seed": 1442100609,
      "versionNonce": 846300427,
      "boundElements": null,
      "id": "nt",
      "type": "text",
      "x": 40,
      "y": 880,
      "width": 1398.7,
      "height": 60.0,
      "text": "Note: nothing reaches this service from the internet — requests only come from the internal service network.\nOnly outbound traffic passes through NAT to reach the providers. The queue is attached over a VPC endpoint, so it never crosses the internet.\nThe send workers also talk to the history DB over 5432 — the lines would overlap, so only the intake API path is drawn.",
      "originalText": "Note: nothing reaches this service from the internet — requests only come from the internal service network.\nOnly outbound traffic passes through NAT to reach the providers. The queue is attached over a VPC endpoint, so it never crosses the internet.\nThe send workers also talk to the history DB over 5432 — the lines would overlap, so only the intake API path is drawn.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
