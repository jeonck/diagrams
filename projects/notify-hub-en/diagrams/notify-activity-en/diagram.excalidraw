      "versionNonce": 1095933349,
      "boundElements": null,
      "id": "nt",
      "type": "text",
      "x": 40,
      "y": 1200,
      "width": 1180.5,
      "height": 60.0,
      "text": "Note: a diamond is a branch. The first branch is the worker-stage guard from ADR 0003 —\na conditional UPDATE claims the row, so even when the queue hands over the same message twice only one worker sends it.\nA retry is drawn as another trip around the same cycle.",
      "originalText": "Note: a diamond is a branch. The first branch is the worker-stage guard from ADR 0003 —\na conditional UPDATE claims the row, so even when the queue hands over the same message twice only one worker sends it.\nA retry is drawn as another trip around the same cycle.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    }
